# ── Copy this file to .env and fill in real values ───────────────────────────
# .env is git-ignored. Never commit it.

# ── Local PostgreSQL (used by docker-compose.yml) ────────────────────────────
POSTGRES_DB=churchattendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── Supabase (used by docker-compose.supabase.yml) ───────────────────────────
# DB_CONNECTION=Host=aws-0-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxxx;Password=xxxxx;SSL Mode=Require;Trust Server Certificate=true

# ── JWT — REQUIRED ────────────────────────────────────────────────────────────
# Use a long random string (32+ characters)
JWT_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_HERE
JWT_ISSUER=https://api.yourchurch.org
JWT_AUDIENCE=https://ecclisiya.vercel.app
JWT_EXPIRATION_MINS=10
REFRESH_TOKEN_EXPIRATION_MINS=30

# ── First-boot seed admin ─────────────────────────────────────────────────────
SEED_ADMIN_PHONE=01012345678
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Administrator

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN_0=http://localhost:5173
ALLOWED_ORIGIN_1=https://ecclisiya.vercel.app
